# CascadeSignal secrets — TEMPLATE.
#
# Copy this file to `.env`, fill in the values, and load it before running any
# ingest script:
#
#     cp .env.example .env         # then edit .env with real keys
#     set -a && source .env && set +a
#
# `.env` is gitignored — never commit real keys. Keep this .example in sync
# (placeholder values only) as new keys are added.

# --- Dune Analytics (CAS-5/6/7) — 2,500 free credits/mo -----------------------
# Read by src/cascadesignal/ingest/dune.py (os.environ["DUNE_API_KEY"]).
DUNE_API_KEY=

# --- Hugging Face (CAS-4 arXiv/Zenodo Aave v3 dataset) ------------------------
# Read by src/cascadesignal/ingest/arxiv_aave_v3.py (optional; anon works for
# public records). Get one at https://huggingface.co/settings/tokens
HF_TOKEN=

# --- The Graph (CAS-7 DEX depth: Uniswap v2/v3, Curve subgraphs) --------------
# Decentralized-network query key (100k free queries/mo).
# https://thegraph.com/studio/apikeys/
GRAPH_API_KEY=

# --- Coinglass (CAS covariate: CEX liquidation aggregates) -------------------
# NOTE: historical liquidation endpoints require a PAID tier; the free/hobbyist
# tier returns 401 "Upgrade plan". See data/raw/provenance/source_status.md #10.
COINGLASS_API_KEY=

# --- Archive RPC (CAS-6 cryo surgical backfill) ------------------------------
# e.g. an Alchemy/Chainstack free-tier archive endpoint.
ARCHIVE_RPC_URL=

# --- BigQuery crypto_ethereum (CAS raw-logs fallback, optional) --------------
# Path to a GCP service-account JSON key file.
GOOGLE_APPLICATION_CREDENTIALS=

# --- Etherscan (CAS-47 historical eth_getLogs; free public RPC is archive-gated) --
# Read by scripts/onchain/fetch_svr_feed_events.py. Free tier, no paid plan
# needed. Get one at https://etherscan.io/apis
ETHERSCAN_API_KEY=

# --- Live cascade monitor (LIVE.md) -------------------------------------------
# Read by src/cascadesignal/live/config.py. ARCHIVE_RPC_URL (above) and
# ETHERSCAN_API_KEY (above) are also required. All optional -- unset values
# fall back to the same constants already pinned in configs/ingest.yaml /
# live/decode.py, so the monitor behaves the same unless you override it.

# wss:// endpoint for eth_subscribe live log tailing. Defaults to
# ARCHIVE_RPC_URL with https-> wss substituted (verified working against
# Alchemy's free tier on 2026-08-04).
ARCHIVE_RPC_WS_URL=

# Override the Aave v2 LendingPool / v3 Pool addresses the monitor watches.
LIVE_AAVE_V2_ADDRESS=
LIVE_AAVE_V3_ADDRESS=

# Bar width in blocks, per protocol (default 1 -- one block, ~12.5s). n(t)
# only updates when a bar closes, so a wider bar throws away warning lead that
# is already in the data. mu/alpha/beta are PER-BAR units, so changing this
# invalidates the persisted fit -- the daemon detects the mismatch and refits.
LIVE_AAVE_V2_BAR_BLOCKS=
LIVE_AAVE_V3_BAR_BLOCKS=

# Alert threshold override, per protocol. Set to move the operating point and
# watch the effect live without re-running the (slow) calibration; takes
# precedence over data/live_state/thresholds.json. Lower = earlier warnings,
# more false alarms.
LIVE_AAVE_V2_THRESHOLD=
LIVE_AAVE_V3_THRESHOLD=

# Persistence/debounce filter, per protocol (default 1). Raise one alert only
# after this many CONSECUTIVE above-threshold bars. k>1 suppresses isolated
# single-bar n(t) spikes (most false alarms) while sustained cascade excitation
# still fires, at the cost of k-1 bars of lead. Tuned via
# scripts/live/tune_threshold.py -- see the FAR/lead frontier there.
LIVE_AAVE_V2_DEBOUNCE_K=
LIVE_AAVE_V3_DEBOUNCE_K=

# Cascade clustering (a UI-side liquidation-grouping heuristic, NOT the
# ADR-001 D-A cascade definition -- see src/cascadesignal/live/cascades.py).
# A gap larger than this closes the current cluster; clusters smaller than the
# minimum are dropped as blips. Defaults 20 / 5.
LIVE_CLUSTER_GAP_BLOCKS=
LIVE_CLUSTER_MIN_LIQUIDATIONS=

# Cap on how far back a cold start scores from (default 200000 blocks, ~1
# month). The historical lake ends months behind the chain head, so without
# this a fresh bootstrap replays the whole gap -- at one bar per block that is
# ~1.1M bars and hundreds of MB of log per protocol. Set 0 to replay it all.
LIVE_MAX_CATCHUP_BLOCKS=

# How often (seconds) the daemon polls the finalized head and advances
# scoring (default 15). Finality itself only moves ~every 15 min on mainnet.
LIVE_POLL_INTERVAL_SECONDS=

# How often (seconds) the model is meant to be refit on a trailing window
# (default 7 days) -- not yet wired to an automatic refit job; periodic
# refit is a manual `scripts/live/calibrate_thresholds.py` + daemon restart
# today (see LIVE.md's "periodic refit" note).
LIVE_REFIT_INTERVAL_SECONDS=
