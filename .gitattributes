# Raw data lake tracked via Git LFS (scoped to data/ so source-tree JSON/config
# stays in normal git). Regenerable via scripts/, but backed to the GitHub remote
# so credit-gated pulls (Dune) survive a lost working copy.
data/**/*.parquet filter=lfs diff=lfs merge=lfs -text
data/**/*.json    filter=lfs diff=lfs merge=lfs -text
data/**/*.csv     filter=lfs diff=lfs merge=lfs -text
data/**/*.tar     filter=lfs diff=lfs merge=lfs -text
data/**/*.html    filter=lfs diff=lfs merge=lfs -text
